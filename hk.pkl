amends "package://github.com/jdx/hk/releases/download/v1.52.0/hk@1.52.0#/Config.pkl"
import "package://github.com/jdx/hk/releases/download/v1.52.0/hk@1.52.0#/Builtins.pkl"

// CHANGELOG.md is regenerated by cocogitto on every release and ships without
// a trailing newline, so linting it would fail CI on each release. dist/ and
// target/ are build output.
exclude = List("CHANGELOG.md", "dist", "target")

local linters = new Mapping<String, Step> {
  ["cargo-fmt"] = Builtins.cargo_fmt
  ["cargo-clippy"] = Builtins.cargo_clippy
  ["shellcheck"] = Builtins.shellcheck
  ["shfmt"] = Builtins.shfmt
  ["markdownlint"] = Builtins.markdown_lint
  ["gitleaks"] = Builtins.gitleaks
  ["actionlint"] = Builtins.actionlint
  ["detect-private-key"] = Builtins.detect_private_key
  ["check-merge-conflict"] = Builtins.check_merge_conflict
  ["trailing-whitespace"] = Builtins.trailing_whitespace
  ["newlines"] = Builtins.newlines
  ["check-added-large-files"] = Builtins.check_added_large_files
}

// Whole-project verification. No glob, so every step always runs. `exclusive`
// keeps the cargo and packaging steps from competing over target/ and dist/.
// They run in `pre-push` and `check` only, never in `pre-commit`/`fix`, so
// commits stay fast. A `slow` profile was tried and removed: git hooks do not
// enable profiles, so the steps silently skipped at pre-push.
local verification = new Mapping<String, Step> {
  ["shell-syntax"] {
    check = "bash -n amux.tmux bin/amux scripts/*.sh tests/*.sh"
  }
  ["conventional-commits"] {
    check = "cog check --from-latest-tag"
  }
  ["test-suite"] {
    exclusive = true
    check = "mise run test"
  }
  ["license-notices"] {
    exclusive = true
    depends = List("test-suite")
    check = "mise run licenses-check"
  }
  ["package-check"] {
    exclusive = true
    depends = List("license-notices")
    check = "mise run package-check"
  }
}

hooks {
  ["pre-commit"] {
    fix = true
    stash = "git"
    steps { ...linters }
  }
  ["commit-msg"] {
    steps {
      ["conventional-commit"] = Builtins.check_conventional_commit
    }
  }
  // Pushing is what triggers a release, so the full suite runs here. Check
  // only: nothing rewrites files on the way to a push.
  ["pre-push"] {
    steps {
      ...linters
      ...verification
    }
  }
  ["check"] {
    steps {
      ...linters
      ...verification
    }
  }
  ["fix"] {
    fix = true
    steps { ...linters }
  }
}
